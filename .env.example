# ===== CHE直早报 配置模板 =====
# 复制本文件为 .env 后填写（.env 已在 .gitignore 中，不会上传到仓库）

# --- 发件邮箱 SMTP（必填）---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的邮箱@qq.com
SMTP_PASS=你的SMTP授权码
SMTP_TLS=auto

# --- 收件邮箱（必填，多个用逗号分隔）---
MAIL_TO=收件邮箱1@xx.com,收件邮箱2@xx.com

# --- DeepSeek AI（必填，platform.deepseek.com 申请）---
DEEPSEEK_API_KEY=sk-你的key

# --- 可选：Server酱 微信推送（sct.ftqq.com 申请）---
SENDKEY=
